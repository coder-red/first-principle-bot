# Copy this file to .env and fill in your key.
# .env is gitignored — never commit real credentials.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults shown.
# API_ENDPOINT=https://openrouter.ai/api/v1

# Pin a SPECIFIC model. Do not use "openrouter/auto" or "openrouter/free":
# those are routers that pick a different model per request, and they can land
# on one that cannot chat at all (a run of openrouter/free was routed to
# nvidia/nemotron-3.5-content-safety, which returned 17 characters).
#
# Benchmarked on this app's actual workload:
#   inclusionai/ling-2.6-flash                 depth-4 deck, longest reasoning, $0.03/Mtok
#   meta-llama/llama-3.3-70b-instruct          depth-4 deck
#   mistralai/mistral-small-24b-instruct-2501  depth-3 deck
# The model must support response_format=json_object.
# MODEL=inclusionai/ling-2.6-flash

# Comma-separated models tried in order if the primary fails.
# FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct-2501

# Raise if decks come back truncated (finish_reason=length). A reasoning model
# bills hidden thinking against this without reporting it, which is why the
# default is far above what a deck's visible output needs.
# DECK_MAX_TOKENS=12000

# Ceiling on a single model call. Decks normally take 25-35s; without a limit a
# stalled provider holds the request open forever.
# DECK_TIMEOUT_SECONDS=90

# Server binding. 127.0.0.1 is local-only. Widening it exposes the endpoints
# that spend your credits — set APP_ACCESS_TOKEN below if you do.
# HOST=127.0.0.1
# PORT=8000
# RELOAD=1

# How much the app says about itself. DEBUG adds every provider attempt.
# LOG_LEVEL=INFO

# ── Deployment ───────────────────────────────────────────────────────────
# Required in a container: the app binds to loopback and runs the reloader
# by default, both of which are wrong on a host.
# HOST=0.0.0.0
# RELOAD=0

# Shown against every request in the OpenRouter dashboard.
# PUBLIC_URL=https://your-app.onrender.com

# Per-IP ceilings on the endpoints that spend model credits. A deck is the
# expensive call; a sector only costs one when its pool needs topping up.
# DECK_RATE_LIMIT=8
# DECK_RATE_WINDOW=300
# EXPLORE_RATE_LIMIT=20
# EXPLORE_RATE_WINDOW=300

# Send raw provider errors to the browser. Leave off in public: they carry
# model names and endpoint URLs. Failures are logged either way.
# DEBUG_ERRORS=1

# ── Access control (optional) ────────────────────────────────────────────
# Unset, the app is open — anyone who can reach the port can spend your model
# credits, and the rate limits only bound how fast. Set this and /api/chat,
# /api/chat/stream and /api/explore/<sector> all require the token.
#
# It is a single shared secret, not user accounts. The browser posts it once to
# /api/access and gets an HttpOnly cookie back, so it is never held in
# JavaScript. /api/health stays open either way, because a platform health
# check calls it and a 401 there would take the service down.
#
# APP_ACCESS_TOKEN=

# Ceiling on token guesses per IP. Tighter than the others because a caller
# with no token never reaches any other limiter.
# ACCESS_RATE_LIMIT=10
# ACCESS_RATE_WINDOW=600

# ── Persistence (optional) ───────────────────────────────────────────────
# Unset, the provider cooldowns, the rate limits and the explore pools all
# live in memory and reset when the process restarts. That is fine locally and
# costs you on a host that sleeps: the first request after every wake-up pays
# for a call to a provider whose daily allowance is already spent.
#
# Point this at a writable path and all three survive a restart. Stdlib
# sqlite3, no server, a few kilobytes. It needs a real disk — on a host with
# an ephemeral filesystem the file goes away with the container, which is no
# worse than leaving this unset.
#
# STATE_DB=./state.db

# ── Providers ────────────────────────────────────────────────────────────
# Every free tier is capped PER ACCOUNT PER DAY, not per visitor. One free
# provider cannot carry a public app: the first handful of visitors spend the
# allowance and everyone after gets a 429. Chaining several is what makes a
# free deploy actually hold up.
#
# List them in the order to try. Each needs a key and a model; any that is not
# fully configured is skipped, so you can list one before you have signed up.
#
# PROVIDERS=groq,gemini,cerebras,openrouter
#
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=
# GEMINI_API_KEY=...
# GEMINI_MODEL=
# CEREBRAS_API_KEY=...
# CEREBRAS_MODEL=
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=
#
# Base URLs are built in for: groq, gemini, cerebras, nvidia, mistral, together,
# openrouter, openai. Anything else works too if you give it an endpoint:
# MYHOST_ENDPOINT=https://example.com/v1
#
# THE ONE HARD REQUIREMENT: the model must support
# response_format: {"type": "json_object"}. A model without it returns prose
# and every deck fails. Check the provider's model list before picking, and
# confirm with /api/health once the server is up.
#
# Leaving PROVIDERS unset keeps the old single-endpoint behaviour
# (OPENROUTER_API_KEY + MODEL + FALLBACK_MODELS) working unchanged.

# ── Spreading load across free tiers ─────────────────────────────────────
# Caps are usually per MODEL per day, so several models behind one key are
# several allowances. <NAME>_MODELS (plural) expands into one chain entry per
# model, all sharing the key and endpoint:
#
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
#
# The pool works down the list in the order you wrote it, and does NOT rotate.
# Spreading requests evenly would assume the allowances are comparable, and
# they are not: Groq refills 8000 tokens every minute while a Gemini model gets
# 20 requests for the whole day, so rotating spends the scarce allowance to
# relieve the renewable one. Put the renewable entry first.
#
# It remembers any entry that returned 429/413/402 and skips it until its
# cooldown expires, instead of costing a doomed call every time. A malformed
# deck does NOT cool an entry — that is a bad roll from a working provider,
# not a capacity problem.
#
# <NAME>_MAX_TOKENS caps one provider's budget. Needed because providers
# disagree: Gemini bills hidden thinking against it and needs ~12000, while
# Groq's free tier caps tokens-per-minute at 8000 and rejects that with 413.
# GROQ_MAX_TOKENS=6000
