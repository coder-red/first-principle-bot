# Copy this file to .env and fill in your key.
# .env is gitignored — never commit real credentials.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults shown.
# API_ENDPOINT=https://openrouter.ai/api/v1

# Pin a SPECIFIC model. Do not use "openrouter/auto" or "openrouter/free":
# those are routers that pick a different model per request, and they can land
# on one that cannot chat at all (a run of openrouter/free was routed to
# nvidia/nemotron-3.5-content-safety, which returned 17 characters).
#
# Benchmarked on this app's actual workload:
#   inclusionai/ling-2.6-flash                 depth-4 deck, longest reasoning, $0.03/Mtok
#   meta-llama/llama-3.3-70b-instruct          depth-4 deck
#   mistralai/mistral-small-24b-instruct-2501  depth-3 deck
# The model must support response_format=json_object.
# MODEL=inclusionai/ling-2.6-flash

# Comma-separated models tried in order if the primary fails.
# FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct-2501

# Raise if decks come back truncated (finish_reason=length).
# DECK_MAX_TOKENS=4000

# Ceiling on a single model call. Decks normally take 25-35s; without a limit a
# stalled provider holds the request open forever.
# DECK_TIMEOUT_SECONDS=90

# Server binding. 127.0.0.1 is local-only; only widen this deliberately —
# there is no auth or rate limiting on /api/chat.
# HOST=127.0.0.1
# PORT=8000
# RELOAD=1

# ── Deployment ───────────────────────────────────────────────────────────
# Required in a container: the app binds to loopback and runs the reloader
# by default, both of which are wrong on a host.
# HOST=0.0.0.0
# RELOAD=0

# Shown against every request in the OpenRouter dashboard.
# PUBLIC_URL=https://your-app.onrender.com

# Per-IP ceilings on the endpoints that spend model credits. A deck is the
# expensive call; a sector only costs one when its pool needs topping up.
# DECK_RATE_LIMIT=8
# DECK_RATE_WINDOW=300
# EXPLORE_RATE_LIMIT=20
# EXPLORE_RATE_WINDOW=300

# Send raw provider errors to the browser. Leave off in public: they carry
# model names and endpoint URLs. Failures are logged either way.
# DEBUG_ERRORS=1
