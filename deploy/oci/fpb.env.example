# Copy to /etc/fpb/fpb.env, fill in, then lock it down:
#
#   sudo install -d -m 750 -o root -g fpb /etc/fpb
#   sudo install -m 640 -o root -g fpb deploy/oci/fpb.env.example /etc/fpb/fpb.env
#   sudo nano /etc/fpb/fpb.env
#
# Read by systemd, NOT by python-dotenv. systemd's format is stricter than a
# .env file: KEY=value, no `export`, no shell expansion, no inline comments
# after a value, and quote anything containing spaces.
#
# .env.example in the repo root documents every setting and why it exists.
# This file is only the subset a server actually needs.

# ── Required on a public URL ─────────────────────────────────────────────
# Without this, anyone who finds the domain spends your provider credits, and
# the rate limits only bound how fast. Generate one:
#     openssl rand -base64 32
APP_ACCESS_TOKEN=

# Must be the https:// URL. The access cookie is only marked Secure when this
# starts with https, so getting it wrong sends the shared token in the clear.
PUBLIC_URL=https://fpb.example.com

# ── Server ───────────────────────────────────────────────────────────────
# Loopback on purpose: nginx is the only thing that should reach uvicorn. This
# is the app's own default, unlike a container deploy where it has to be
# 0.0.0.0 — here the default is already correct and stated for clarity.
HOST=127.0.0.1
PORT=8000

# REQUIRED. The default is 1, and the reloader forks a child process that
# systemd does not track, so Restart= would watch the wrong PID.
RELOAD=0

LOG_LEVEL=INFO

# ── Persistence ──────────────────────────────────────────────────────────
# The whole reason a VM beats a sleeping free-tier host. Provider cooldowns,
# rate limits and the explore pools survive a restart. The cooldowns are the
# ones that cost money: without this, every restart retries providers whose
# daily allowance is already spent. The unit grants write access to this
# directory and nowhere else.
STATE_DB=/var/lib/fpb/state.db

# ── Providers ────────────────────────────────────────────────────────────
# In the order to try. Anything not fully configured is skipped, so you can
# list one before signing up for it. The model MUST support
# response_format={"type":"json_object"} or every deck fails.
PROVIDERS=groq,gemini,openrouter

GROQ_API_KEY=
GROQ_MODEL=
# Groq's free tier caps tokens-per-minute at 8000 and counts max_tokens toward
# it, so the 12000 Gemini needs comes back 413.
GROQ_MAX_TOKENS=6000

GEMINI_API_KEY=
# Plural: caps are per model, so each entry is its own daily allowance.
GEMINI_MODELS=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Per-IP limits ────────────────────────────────────────────────────────
# These only mean anything because nginx overwrites X-Forwarded-For with the
# real peer. See the comment on that line in deploy/oci/nginx.conf.
DECK_RATE_LIMIT=8
DECK_RATE_WINDOW=300
EXPLORE_RATE_LIMIT=20
EXPLORE_RATE_WINDOW=300
ACCESS_RATE_LIMIT=10
ACCESS_RATE_WINDOW=600

# ── Leave off in public ──────────────────────────────────────────────────
# Sends raw provider errors to the browser: model names, endpoint URLs, and
# sometimes an echo of the request. Failures are logged either way.
# DEBUG_ERRORS=1
