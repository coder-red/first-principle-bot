# Real credentials. `.env.example` is the only env file that belongs in the
# repo, so ignore the whole family and re-admit that one.
.env
.env.*
!.env.example

# Anything else that is a credential by shape rather than by name.
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

__pycache__/
*.pyc
.pytest_cache/

# browser-suite screenshots
_shots/
*.png

# Optional STATE_DB file, plus the two WAL sidecars SQLite writes beside it.
*.db
*.db-wal
*.db-shm

# Local planning notes, never published.
docs/superpowers/
